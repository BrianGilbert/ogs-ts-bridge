<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OgsaTsBridge</RootNamespace>
    <AssemblyName>ogsa-ts-bridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Latency: workstation GC + concurrent GC keeps gen0 collections short;
         the hot path allocates one small buffer per motion frame. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>0.1.0</Version>
    <PackageId>ogsa-ts-bridge</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Capnp.Net.Runtime" Version="1.3.118" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OgsaTsBridge.Tests" />
  </ItemGroup>

  <!-- Vendored engine-agnostic core from ogsa-ts-dotnet (sync-core.ps1). -->
  <ItemGroup>
    <Compile Include="..\..\OgsaTelemetry\*.cs" Link="OgsaTelemetry\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
