        <SolidColorBrush x:Key="PanelAlt" Color="#2E313A"/>
        <SolidColorBrush x:Key="Fg" Color="#E8EAF0"/>
        <SolidColorBrush x:Key="FgDim" Color="#9AA0AE"/>
