<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OgsaTsBridge</RootNamespace>
    <!-- Latency: the forward path allocates one small buffer per frame;
         workstation concurrent GC keeps any pause micro-scale. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Vendored engine-agnostic core from ogsa-ts-dotnet (sync-core.ps1). -->
  <ItemGroup>
    <Compile Include="..\..\OgsaTelemetry\*.cs" Link="OgsaTelemetry\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OgsaTsBridge.Tests" />
  </ItemGroup>

</Project>
